<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="root"
            prefHeight="820" prefWidth="1280"
            styleClass="gx-root"
            xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.grabx.app.grabx.MainController">

    <!-- TOP BAR -->
    <top>
        <VBox styleClass="gx-top-wrap">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="gx-topbar">

                <Label styleClass="gx-brand" text="GX" />
                <VBox spacing="2">
                    <Text styleClass="gx-title" text="GrabX" />
                    <Text styleClass="gx-subtitle" text="Downloader" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Add Link -->
                <Button fx:id="addLinkButton" onAction="#onAddLink" prefHeight="40" prefWidth="40">

                    <styleClass>
                        <String fx:value="gx-icon-btn" />
                        <String fx:value="gx-icon-primary" />
                    </styleClass>
                </Button>

                <!-- Pause All -->
                <Button fx:id="pauseAllButton" onAction="#onPauseAll" prefHeight="40" prefWidth="40" styleClass="gx-icon-btn">

                </Button>

                <!-- Resume All -->
                <Button fx:id="resumeAllButton" onAction="#onResumeAll" prefHeight="40" prefWidth="40" styleClass="gx-icon-btn">

                </Button>

                <!-- Clear All -->
                <Button fx:id="clearAllButton" onAction="#onClearAll" prefHeight="40" prefWidth="40">
                    <styleClass>
                        <String fx:value="gx-icon-btn" />
                        <String fx:value="gx-icon-danger" />
                    </styleClass>

                </Button><Button fx:id="cancelAllBtn" onAction="#onCanseleAll" prefHeight="40" prefWidth="40">
                    <styleClass>
                        <String fx:value="gx-icon-btn" />
                        <String fx:value="gx-icon-danger" />
                    </styleClass>
                </Button>

                <!-- Settings -->
                <Button fx:id="settingsButton" onAction="#onSettings" prefHeight="40" prefWidth="40" styleClass="gx-icon-btn">

                </Button>

            </HBox>
        </VBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <HBox spacing="12" styleClass="gx-main">

            <!-- LEFT SIDEBAR -->
            <VBox maxWidth="240" minWidth="240" spacing="10" styleClass="gx-sidebar">
                <Label styleClass="gx-sidebar-section" text="Library" />

                <ListView fx:id="sidebarList"
                          styleClass="gx-sidebar-list"
                          VBox.vgrow="ALWAYS" />

                <Button onAction="#onMiniMode" text="Mini Mode">
                    <styleClass>
                        <String fx:value="gx-btn" />
                        <String fx:value="gx-btn-ghost" />
                    </styleClass>
                </Button>
            </VBox>

            <!-- CENTER CONTENT -->
            <VBox spacing="10" styleClass="gx-content" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="gx-content-header">
                    <Label fx:id="contentTitle" styleClass="gx-section-title" text="Downloads" />
                    <Region HBox.hgrow="ALWAYS" />
                    <StackPane fx:id="searchBox" alignment="CENTER_RIGHT" maxWidth="260"
                               minWidth="46" prefWidth="46" styleClass="gx-search-box">
                        <TextField fx:id="searchField" maxWidth="Infinity" promptText="Search..."
                                   styleClass="gx-search,gx-search-expandable" />
                        <Button fx:id="searchToggleButton" minHeight="42" minWidth="42"
                                prefHeight="42" prefWidth="42" styleClass="gx-search-toggle" />
                    </StackPane>
                    <ComboBox fx:id="historyFilter" maxWidth="145" minWidth="125" prefWidth="135">
                        <styleClass>
                            <String fx:value="gx-combo" />
                            <String fx:value="gx-history-filter" />
                        </styleClass>
                    </ComboBox>
                </HBox>

                <ListView fx:id="downloadsList" styleClass="gx-list" VBox.vgrow="ALWAYS" />
            </VBox>
        </HBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="gx-footer">
            <Label fx:id="statusText" styleClass="gx-text-muted" text="0 active  ·  0 queued  ·  0 completed" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="globalSpeed" alignment="CENTER_RIGHT" minWidth="112" prefWidth="112" maxWidth="112"
                   styleClass="gx-text-muted" text="↓  0 KB/s" textOverrun="CLIP" />
        </HBox>
    </bottom>

    <stylesheets>
        <URL value="@styles/theme-base.css" />
        <URL value="@styles/layout.css" />
        <URL value="@styles/buttons.css" />
        <URL value="@styles/tabs.css" />
        <URL value="@styles/table.css" />
        <URL value="@styles/sidebar.css" />
    </stylesheets>

</BorderPane>
