{
  "manifest_version": 3,
  "name": "GrabX Download Assistant",
  "version": "0.3.2",
  "description": "Detect media and files on the current page and send them securely to GrabX.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Download with GrabX",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/grabx-16.png",
      "32": "icons/grabx-32.png",
      "48": "icons/grabx-48.png",
      "128": "icons/grabx-128.png"
    }
  },
  "icons": {
    "16": "icons/grabx-16.png",
    "32": "icons/grabx-32.png",
    "48": "icons/grabx-48.png",
    "128": "icons/grabx-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-assistant.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
